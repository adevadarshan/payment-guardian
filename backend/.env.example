# .env.example — copy to .env and fill in. Never commit .env.
# Postgres is the deployment target:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/vhs02
# SQLite is accepted for tests and local runs without Postgres:
DATABASE_URL=sqlite:///./vhs02.db
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MODEL_BACKEND=none
THRESHOLD_MEDIUM=35
THRESHOLD_HIGH=75
PIPELINE_VERSION=slice-4
# Keep false in production: client timestamps must not influence scoring.
ALLOW_CLIENT_HOUR=false
# QR intake limits. Payloads are retained in result_json only when
# STORE_QR_PAYLOADS is true; application logs never carry payloads.
QR_MAX_MB=5
QR_MAX_MEGAPIXELS=12
STORE_QR_PAYLOADS=true
# Slice 4: authentication + hardening.
# AUTH_REQUIRED=false is allowed ONLY for local development (APP_ENV=development).
# Production with AUTH_REQUIRED=false refuses to start.
AUTH_REQUIRED=true
DEMO_EMAIL=demo@vhs02.local
DEMO_PASSWORD=demo1234
ADVISORY_ENABLED=false
ADVISORY_TIMEOUT_S=8
ADVISORY_MAX_CHARS=600
RATE_LIMIT_ANALYZE_IP=10
RATE_LIMIT_ANALYZE_USER=60
RATE_LIMIT_LOGIN_IP=5
MAX_CONTENT_BYTES=8388608
TRUSTED_HOSTS=localhost,127.0.0.1
MODEL_BACKEND=none
